// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
  INVITED
}

enum AppLanguage {
  AR
  EN
}

model Role {
  id Int @id @default(autoincrement())

  code String @unique
  nameAr String
  nameEn String

  descriptionAr String?
  descriptionEn String?

  createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

  permissions RolePermission[]
  accounts    AccountRole[]
}


model Permission {
 id Int @id @default(autoincrement())
 
  code String @unique

  nameAr String
  nameEn String

  descriptionAr String?
  descriptionEn String?

  order Int?

  roles RolePermission[]
}


model RolePermission {
  roleId Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}


model Account {
  id Int @id @default(autoincrement())

  phone String @unique
  password String?

  status AccountStatus @default(PENDING_ACTIVATION)

  biometricEnabled Boolean @default(false)
  preferredLanguage AppLanguage @default(AR)

  phoneVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // Audit
  createdById Int?
  createdBy Account? @relation("AccountCreator",fields: [createdById], references: [id] )

  createdAccounts Account[] @relation("AccountCreator")

  patients Patient[]

  createdPatients Patient[] @relation("PatientCreator")

  createdPatientFormFieldDefinitions PatientFormFieldDefinition[] @relation("PatientFormFieldCreator")

  updatedPatientFormFieldValues PatientFormFieldValue[] @relation("PatientFormFieldValueUpdater")

  uploadedMediaFiles MediaFile[]

  updatedClinicSettings ClinicSettings? @relation("ClinicSettingsUpdater")

  roles AccountRole[]

  otpVerifications OtpVerification[]

  createdTreatmentPlanTemplates TreatmentPlanTemplate[]

  createdTreatmentPlans TreatmentPlan[]

  createdContents Content[]

  createdAppointments     Appointment[] @relation("AppointmentCreator")
  confirmedAppointments   Appointment[] @relation("AppointmentConfirmer")
  cancelledAppointments   Appointment[] @relation("AppointmentCanceller")
  rescheduledAppointments Appointment[] @relation("AppointmentRescheduler")
  checkedInAppointments   Appointment[] @relation("AppointmentChecker")

}

model AccountRole {
  accountId Int
  roleId Int

  assignedAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([accountId, roleId])
}

model OtpVerification {
  id Int @id @default(autoincrement())

  accountId Int

  code String @db.VarChar(6)

  type OtpType

  expiresAt DateTime

  verifiedAt DateTime?

  isUsed Boolean @default(false)

  attempts Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation( fields: [accountId], references: [id],  onDelete: Cascade )

  metadata Json?  
  @@index([accountId, type])
}


enum OtpType {
  REGISTER
  LOGIN
  ACCOUNT_ACTIVATION
  RESET_PASSWORD
  CHANGE_PHONE
}

model ClinicSettings {
  id Int @id @default(1)

  bufferTimeMinutes                   Int     @default(0)
  cancelRescheduleWindowHours         Int     @default(24)
  defaultConsultationDurationMinutes  Int     @default(30)
  reminderLeadTimeHours               Int     @default(3)
  ratingValidityHours                 Int     @default(5)
  autoConfirmationEnabled             Boolean @default(false)
  onlineBookingEnabled                Boolean @default(true)

  updatedByAccountId Int? @unique
  updatedBy          Account? @relation("ClinicSettingsUpdater", fields: [updatedByAccountId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
enum PatientStatus {
  ACTIVE
  ARCHIVED
}

enum PatientFormFieldType {
  TEXT
  NUMBER
  DATE
  RADIO
  MULTI_SELECT
  TEXTAREA
}
enum Gender {
  MALE
  FEMALE
}
model MedicalRecordNumberCounter {
  id Int @id
  lastValue Int @default(0)
}
model Patient {

  id Int @id @default(autoincrement())

  accountId Int?
  account Account? @relation(fields: [accountId], references: [id])

  createdById Int?
  createdBy Account? @relation("PatientCreator", fields: [createdById], references: [id])

  medicalRecordNumber String @unique
  
  fullName String
  birthDate DateTime @db.Date
  gender Gender

  lastVisitAt DateTime?

  profileImageId Int?
  profileImage MediaFile? @relation(fields: [profileImageId], references: [id])

  status PatientStatus @default(ACTIVE)
  archivedAt DateTime?

  formValues PatientFormFieldValue[]

  treatmentPlans TreatmentPlan[]
  appointments   Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([fullName])
  @@index([lastVisitAt])
  @@index([fullName, birthDate, gender])
  @@index([profileImageId])
  @@index([accountId])

}
model PatientFormFieldDefinition {

  id Int @id @default(autoincrement())

  key String @unique

  labelAr String
  labelEn String

  type PatientFormFieldType

  required Boolean @default(false)

  validation Json?
  options Json?

  displayOrder Int
  isActive Boolean @default(true)

  createdById Int
  createdBy Account  @relation("PatientFormFieldCreator", fields: [createdById], references: [id])

  values PatientFormFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayOrder])
  @@index([isActive])

}
model PatientFormFieldValue {

  id Int @id @default(autoincrement())

  patientId Int
  patient Patient  @relation(fields: [patientId], references: [id])

  fieldDefinitionId Int
  fieldDefinition PatientFormFieldDefinition  @relation(fields: [fieldDefinitionId], references: [id])

  value Json

  updatedByAccountId Int?

  updatedByAccount Account?  @relation("PatientFormFieldValueUpdater", fields: [updatedByAccountId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([patientId, fieldDefinitionId])
  @@index([patientId])
  @@index([fieldDefinitionId])

}
enum MediaFileCategory {
  PROFILE_IMAGE
  XRAY
  REPORT
  PRESCRIPTION
  CONTENT_IMAGE
  OTHER
}

model MediaFile {
  id Int @id @default(autoincrement())

  originalName String
  storedName   String @unique
  path         String @unique
  mimeType     String
  size         Int
  category     MediaFileCategory

  uploadedByAccountId Int?
  uploadedByAccount   Account? @relation(fields: [uploadedByAccountId], references: [id])

  patientProfile Patient[]

  medicalAttachments MedicalAttachment[]
  contentMediaFiles  ContentMediaFile[]

  createdAt DateTime @default(now())

  @@index([uploadedByAccountId])
  @@index([mimeType])
  @@index([category])
  @@index([createdAt])
}

model TreatmentPlanTemplate {
  id Int @id @default(autoincrement())

  nameAr String
  nameEn String

  // Computed automatically as SUM(sessionTemplates.estimatedCost) — never set manually via API.
  estimatedCost Decimal @default(0) @db.Decimal(10, 2)

  createdByAccountId Int?
  createdByAccount   Account? @relation(fields: [createdByAccountId], references: [id])

  isActive Boolean @default(true)

  sessionTemplates TreatmentSessionTemplate[]
  treatmentPlans   TreatmentPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model TreatmentSessionTemplate {
  id Int @id @default(autoincrement())

  planTemplateId Int
  planTemplate   TreatmentPlanTemplate @relation(fields: [planTemplateId], references: [id], onDelete: Cascade)

  titleAr String
  titleEn String

  sessionOrder Int

  durationMinutes      Int?
  // Abstract day-count only in Epic A (no real date — template has no patient/real session).
  // Epic B: availableForBookingAt = previous session completion date + this number.
  minDaysBeforeBooking Int?

  estimatedCost Decimal @default(0) @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planTemplateId])
  @@index([isActive])
  @@unique([planTemplateId, sessionOrder])
}

enum TreatmentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TreatmentSessionStatus {
  PENDING
  BOOKED
  IN_TREATMENT
  COMPLETED
  CANCELLED
}

enum EncounterStatus {
  IN_TREATMENT
  COMPLETED
}

enum MedicalAttachmentType {
  XRAY
  REPORT
  PHOTO
}

enum AppointmentStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  CHECKED_IN
  IN_TREATMENT
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
}

model TreatmentPlan {
  id Int @id @default(autoincrement())

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  createdByAccountId Int?
  createdByAccount   Account? @relation(fields: [createdByAccountId], references: [id])

  templateId Int?
  template   TreatmentPlanTemplate? @relation(fields: [templateId], references: [id])

  nameAr String?
  nameEn String?

  status TreatmentPlanStatus @default(ACTIVE)

  estimatedCost Decimal @default(0) @db.Decimal(10, 2)
  actualCost    Decimal @default(0) @db.Decimal(10, 2)

  isActive Boolean @default(true)

  sessions TreatmentSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([status])
  @@index([isActive])
}

model TreatmentSession {
  id Int @id @default(autoincrement())

  treatmentPlanId Int
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  titleAr String
  titleEn String

  sessionOrder Int

  durationMinutes      Int?
  minDaysBeforeBooking Int?

  estimatedCost Decimal  @default(0) @db.Decimal(10, 2)
  actualCost    Decimal? @db.Decimal(10, 2)

  availableForBookingAt DateTime?

  status TreatmentSessionStatus @default(PENDING)

  completedAt DateTime?

  rating  Int?
  ratedAt DateTime?

  encounter    Encounter?
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([treatmentPlanId])
  @@index([status])
  @@index([availableForBookingAt])
  @@unique([treatmentPlanId, sessionOrder])
}

model Appointment {
  id Int @id @default(autoincrement())

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  createdById Int?
  createdBy   Account? @relation("AppointmentCreator", fields: [createdById], references: [id])

  treatmentSessionId Int?
  treatmentSession   TreatmentSession? @relation(fields: [treatmentSessionId], references: [id])

  confirmedById Int?
  confirmedBy   Account? @relation("AppointmentConfirmer", fields: [confirmedById], references: [id])

  cancelledById Int?
  cancelledBy   Account? @relation("AppointmentCanceller", fields: [cancelledById], references: [id])

  rescheduledById Int?
  rescheduledBy   Account? @relation("AppointmentRescheduler", fields: [rescheduledById], references: [id])

  checkedInById Int?
  checkedInBy   Account? @relation("AppointmentChecker", fields: [checkedInById], references: [id])

  type AppointmentType

  scheduledAt DateTime

  /// Snapshot from ClinicSettings at booking time
  durationMinutes Int

  status AppointmentStatus @default(PENDING_CONFIRMATION)

  isWaiting Boolean @default(false)

  reasonForVisit String?
  chatbotSummary String?
  notes          String?

  confirmedAt DateTime?

  cancellationReason String?

  checkedInAt DateTime?

  rescheduledAt DateTime?

  cancelledAt DateTime?

  completedAt DateTime?

  encounters Encounter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([status])
  @@index([type])
  @@index([scheduledAt])
  @@index([scheduledAt, status])
  @@index([patientId, status])
  @@index([treatmentSessionId])
  @@index([createdById])
  @@index([confirmedById])
  @@index([cancelledById])
  @@index([checkedInById])
  @@index([rescheduledById])
}

model Encounter {
  id Int @id @default(autoincrement())

  treatmentSessionId Int              @unique
  treatmentSession   TreatmentSession @relation(fields: [treatmentSessionId], references: [id], onDelete: Cascade)

  appointmentId Int?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  status EncounterStatus @default(IN_TREATMENT)

  diagnosis     String? @db.Text
  clinicalNotes String? @db.Text
  // Fixed-length array of 48 tooth entries (initialized on session start).
  teeth         Json
  prescription  String? @db.Text

  attachments MedicalAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
}

model MedicalAttachment {
  id Int @id @default(autoincrement())

  encounterId Int
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  mediaFileId Int
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id])

  type  MedicalAttachmentType
  title String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([encounterId])
  @@index([mediaFileId])
}

enum ContentType {
  ARTICLE
  NEWS
  OFFER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Content {
  id Int @id @default(autoincrement())

  type   ContentType
  status ContentStatus @default(DRAFT)

  titleAr String
  titleEn String
  bodyAr  String? @db.Text
  bodyEn  String? @db.Text

  createdByAccountId Int?
  createdByAccount   Account? @relation(fields: [createdByAccountId], references: [id])

  mediaFiles ContentMediaFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
}

model ContentMediaFile {
  id Int @id @default(autoincrement())

  contentId Int
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  mediaFileId Int
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id])

  displayOrder Int @default(0)

  @@unique([contentId, mediaFileId])
  @@index([contentId, displayOrder])
}
