// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
  INVITED
}

enum AppLanguage {
  AR
  EN
}

model Role {
  id Int @id @default(autoincrement())

  code String @unique
  nameAr String
  nameEn String

  descriptionAr String?
  descriptionEn String?

  createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

  permissions RolePermission[]
  accounts    AccountRole[]
}


model Permission {
 id Int @id @default(autoincrement())
 
  code String @unique

  nameAr String
  nameEn String

  descriptionAr String?
  descriptionEn String?

  order Int?

  roles RolePermission[]
}


model RolePermission {
  roleId Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}


model Account {
  id Int @id @default(autoincrement())

  phone String @unique
  password String?

  status AccountStatus @default(PENDING_ACTIVATION)

  biometricEnabled Boolean @default(false)
  preferredLanguage AppLanguage @default(AR)

  phoneVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // Audit
  createdById Int?
  createdBy Account? @relation("AccountCreator",fields: [createdById], references: [id] )

  createdAccounts Account[] @relation("AccountCreator")

  patients Patient[]

  createdPatients Patient[] @relation("PatientCreator")

  createdPatientFormFieldDefinitions PatientFormFieldDefinition[] @relation("PatientFormFieldCreator")

  updatedPatientFormFieldValues PatientFormFieldValue[] @relation("PatientFormFieldValueUpdater")

  uploadedMediaFiles MediaFile[]

  updatedClinicSettings ClinicSettings? @relation("ClinicSettingsUpdater")

  clinicWorkingHoursUpdates ClinicWorkingHours[] @relation("ClinicWorkingHoursUpdater")
  createdScheduleExceptions ClinicScheduleException[] @relation("ClinicScheduleExceptionCreator")

  roles AccountRole[]

  otpVerifications OtpVerification[]

}

model AccountRole {
  accountId Int
  roleId Int

  assignedAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([accountId, roleId])
}

model OtpVerification {
  id Int @id @default(autoincrement())

  accountId Int

  code String @db.VarChar(6)

  type OtpType

  expiresAt DateTime

  verifiedAt DateTime?

  isUsed Boolean @default(false)

  attempts Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation( fields: [accountId], references: [id],  onDelete: Cascade )

  metadata Json?  
  @@index([accountId, type])
}


enum OtpType {
  REGISTER
  LOGIN
  ACCOUNT_ACTIVATION
  RESET_PASSWORD
  CHANGE_PHONE
}

model ClinicSettings {
  id Int @id @default(1)

  bufferTimeMinutes                   Int     @default(0)
  cancelRescheduleWindowHours         Int     @default(24)
  defaultConsultationDurationMinutes  Int     @default(30)
  reminderLeadTimeHours               Int     @default(3)
  ratingValidityHours                 Int     @default(5)
  autoConfirmationEnabled             Boolean @default(false)
  onlineBookingEnabled                Boolean @default(true)
  maxBookingHorizonDays               Int     @default(30)

  updatedByAccountId Int? @unique
  updatedBy          Account? @relation("ClinicSettingsUpdater", fields: [updatedByAccountId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

/// Weekly clinic opening pattern (single-clinic / single-doctor assumption).
model ClinicWorkingHours {
  id Int @id @default(autoincrement())

  dayOfWeek    DayOfWeek @unique
  isWorkingDay Boolean   @default(true)

  /// Minutes from midnight (540 = 09:00). Null when not a working day.
  startMinute Int?
  endMinute   Int?
  /// [{ startMinute, endMinute }] — must lie fully inside [startMinute, endMinute]
  breaks      Json?

  updatedByAccountId Int?
  updatedBy          Account? @relation("ClinicWorkingHoursUpdater", fields: [updatedByAccountId], references: [id])
  updatedAt          DateTime @updatedAt
}

/// Per-date override of the weekly pattern (holiday / special hours).
model ClinicScheduleException {
  id Int @id @default(autoincrement())

  date         DateTime @unique @db.Date
  isWorkingDay Boolean

  startMinute Int?
  endMinute   Int?
  breaks      Json?

  reason String?

  createdByAccountId Int
  createdBy          Account @relation("ClinicScheduleExceptionCreator", fields: [createdByAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PatientStatus {
  ACTIVE
  ARCHIVED
}

enum PatientFormFieldType {
  TEXT
  NUMBER
  DATE
  RADIO
  MULTI_SELECT
  TEXTAREA
}
enum Gender {
  MALE
  FEMALE
}
model MedicalRecordNumberCounter {
  id Int @id
  lastValue Int @default(0)
}
model Patient {

  id Int @id @default(autoincrement())

  accountId Int?
  account Account? @relation(fields: [accountId], references: [id])

  createdById Int?
  createdBy Account? @relation("PatientCreator", fields: [createdById], references: [id])

  medicalRecordNumber String @unique
  
  fullName String
  birthDate DateTime @db.Date
  gender Gender

  lastVisitAt DateTime?

  profileImageId Int?
  profileImage MediaFile? @relation(fields: [profileImageId], references: [id])

  status PatientStatus @default(ACTIVE)
  archivedAt DateTime?

  formValues PatientFormFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([fullName])
  @@index([lastVisitAt])
  @@index([fullName, birthDate, gender])
  @@index([profileImageId])
  @@index([accountId])

}
model PatientFormFieldDefinition {

  id Int @id @default(autoincrement())

  key String @unique

  labelAr String
  labelEn String

  type PatientFormFieldType

  required Boolean @default(false)

  validation Json?
  options Json?

  displayOrder Int
  isActive Boolean @default(true)

  createdById Int
  createdBy Account  @relation("PatientFormFieldCreator", fields: [createdById], references: [id])

  values PatientFormFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayOrder])
  @@index([isActive])

}
model PatientFormFieldValue {

  id Int @id @default(autoincrement())

  patientId Int
  patient Patient  @relation(fields: [patientId], references: [id])

  fieldDefinitionId Int
  fieldDefinition PatientFormFieldDefinition  @relation(fields: [fieldDefinitionId], references: [id])

  value Json

  updatedByAccountId Int?

  updatedByAccount Account?  @relation("PatientFormFieldValueUpdater", fields: [updatedByAccountId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([patientId, fieldDefinitionId])
  @@index([patientId])
  @@index([fieldDefinitionId])

}
enum MediaFileCategory {
  PROFILE_IMAGE
  XRAY
  REPORT
  PRESCRIPTION
  CONTENT_IMAGE
  OTHER
}

model MediaFile {
  id Int @id @default(autoincrement())

  originalName String
  storedName   String @unique
  path         String @unique
  mimeType     String
  size         Int
  category     MediaFileCategory

  uploadedByAccountId Int?
  uploadedByAccount   Account? @relation(fields: [uploadedByAccountId], references: [id])

  patientProfile Patient[]

  // medicalAttachments MedicalAttachment[]
  // contentMedia ContentMediaFile[]

  createdAt DateTime @default(now())

  @@index([uploadedByAccountId])
  @@index([mimeType])
  @@index([category])
  @@index([createdAt])
}

