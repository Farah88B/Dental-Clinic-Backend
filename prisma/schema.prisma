// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
  INVITED
}

enum AppLanguage {
  AR
  EN
}

model Role {
  id Int @id @default(autoincrement())

  code String @unique
  nameAr String
  nameEn String

  descriptionAr String?
  descriptionEn String?

  createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

  permissions RolePermission[]
  accounts    AccountRole[]
}


model Permission {
 id Int @id @default(autoincrement())
 
  code String @unique

  nameAr String
  nameEn String

  descriptionAr String?
  descriptionEn String?

  order Int?

  roles RolePermission[]
}


model RolePermission {
  roleId Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}


model Account {
  id Int @id @default(autoincrement())

  phone String @unique
  password String?

  status AccountStatus @default(PENDING_ACTIVATION)

  biometricEnabled Boolean @default(false)
  preferredLanguage AppLanguage @default(AR)

  phoneVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // Audit
  createdById Int?
  createdBy Account? @relation("AccountCreator",fields: [createdById], references: [id] )

  createdAccounts Account[] @relation("AccountCreator")

  patients Patient[]

  createdPatients Patient[] @relation("PatientCreator")

  createdPatientFormFieldDefinitions PatientFormFieldDefinition[] @relation("PatientFormFieldCreator")

  updatedPatientFormFieldValues PatientFormFieldValue[] @relation("PatientFormFieldValueUpdater")

  uploadedMediaFiles MediaFile[]

  updatedClinicSettings ClinicSettings? @relation("ClinicSettingsUpdater")

  roles AccountRole[]

  otpVerifications OtpVerification[]

}

model AccountRole {
  accountId Int
  roleId Int

  assignedAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([accountId, roleId])
}

model OtpVerification {
  id Int @id @default(autoincrement())

  accountId Int

  code String @db.VarChar(6)

  type OtpType

  expiresAt DateTime

  verifiedAt DateTime?

  isUsed Boolean @default(false)

  attempts Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation( fields: [accountId], references: [id],  onDelete: Cascade )

  metadata Json?  
  @@index([accountId, type])
}


enum OtpType {
  REGISTER
  LOGIN
  ACCOUNT_ACTIVATION
  RESET_PASSWORD
  CHANGE_PHONE
}

model ClinicSettings {
  id Int @id @default(1)

  bufferTimeMinutes                   Int     @default(0)
  cancelRescheduleWindowHours         Int     @default(24)
  defaultConsultationDurationMinutes  Int     @default(30)
  reminderLeadTimeHours               Int     @default(3)
  ratingValidityHours                 Int     @default(5)
  autoConfirmationEnabled             Boolean @default(false)
  onlineBookingEnabled                Boolean @default(true)

  updatedByAccountId Int? @unique
  updatedBy          Account? @relation("ClinicSettingsUpdater", fields: [updatedByAccountId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
enum PatientStatus {
  ACTIVE
  ARCHIVED
}

enum PatientFormFieldType {
  TEXT
  NUMBER
  DATE
  RADIO
  MULTI_SELECT
  TEXTAREA
}
enum Gender {
  MALE
  FEMALE
}
model Patient {

  id Int @id @default(autoincrement())

  accountId Int?
  account Account? @relation(fields: [accountId], references: [id])

  createdById Int?
  createdBy Account? @relation("PatientCreator", fields: [createdById], references: [id])

  medicalRecordNumber String @unique
  
  fullName String
  birthDate DateTime @db.Date
  gender Gender

  lastVisitAt DateTime?

  profileImageId Int?
  profileImage MediaFile? @relation(fields: [profileImageId], references: [id])

  status PatientStatus @default(ACTIVE)
  archivedAt DateTime?

  formValues PatientFormFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([fullName])
  @@index([lastVisitAt])
  @@index([fullName, birthDate, gender])
  @@index([profileImageId])
  @@index([accountId])

}
model PatientFormFieldDefinition {

  id Int @id @default(autoincrement())

  key String @unique

  labelAr String
  labelEn String

  type PatientFormFieldType

  required Boolean @default(false)

  validation Json?
  options Json?

  displayOrder Int
  isActive Boolean @default(true)

  createdById Int
  createdBy Account  @relation("PatientFormFieldCreator", fields: [createdById], references: [id])

  values PatientFormFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayOrder])
  @@index([isActive])

}
model PatientFormFieldValue {

  id Int @id @default(autoincrement())

  patientId Int
  patient Patient  @relation(fields: [patientId], references: [id])

  fieldDefinitionId Int
  fieldDefinition PatientFormFieldDefinition  @relation(fields: [fieldDefinitionId], references: [id])

  value Json

  updatedByAccountId Int?

  updatedByAccount Account?  @relation("PatientFormFieldValueUpdater", fields: [updatedByAccountId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([patientId, fieldDefinitionId])
  @@index([patientId])
  @@index([fieldDefinitionId])

}
model MediaFile {

  id Int @id @default(autoincrement())

  originalName String
  path String  @unique
  mimeType String
  size Int

  uploadedByAccountId Int?
  uploadedByAccount Account?  @relation(fields: [uploadedByAccountId], references: [id])

  patientProfile Patient[]  

 // medicalAttachments MedicalAttachment[]

 // contentMedia ContentMediaFile[]

  createdAt DateTime @default(now())

  @@index([uploadedByAccountId])
  @@index([mimeType])
  @@index([createdAt])

}