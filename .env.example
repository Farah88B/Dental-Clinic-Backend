APP_NAME="Dental Clinic Backend"
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/dental_clinic?schema=public"
PORT=3000
NODE_ENV=development
JWT_SECRET=some-super-long-secret-key-at-least-32-chars
JWT_ACCESS_SECRET=some-super-long-access-secret-key-at-least-32-chars
JWT_REFRESH_SECRET=some-super-long-refresh-secret-key-at-least-32-chars
MEDIA_UPLOAD_ROOT=uploads
MEDIA_PUBLIC_PATH=/uploads
CLINIC_TIMEZONE=Asia/Damascus
CLINIC_CHECKIN_QR_SECRET=change-me-clinic-checkin-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SMS_MODE=stub
SMS_PROVIDER=traccar
# SMS_STATIC_OTP_CODE is unused — stub generates a random OTP and returns it in API responses
# Traccar: SMS_API_URL=https://www.traccar.org/sms/
# SMSChef: SMS_API_URL=https://www.cloud.smschef.com/api/send/sms
SMS_API_URL=https://www.traccar.org/sms/
SMS_API_KEY=
# Required when SMS_PROVIDER=smschef (device UUID from SMSChef dashboard)
SMS_DEVICE_ID=
SMS_SIM=1